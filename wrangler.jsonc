{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "felipebasurto-com",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  "build": {
    "command": "npm run build:dist"
  },
  "observability": {
    "enabled": true
  }
}
